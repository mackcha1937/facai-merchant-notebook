{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facai.local/schemas/recommendation.schema.json",
  "title": "发财推荐结果",
  "type": "object",
  "additionalProperties": false,
  "required": ["recommendation_id", "customer_id", "reason", "suggested_action", "owner_script", "evidence", "risk_flags", "score", "expires_at"],
  "properties": {
    "recommendation_id": { "type": "string" },
    "customer_id": { "type": "string" },
    "target_type": { "type": "string", "enum": ["product", "service", "care_followup", "repurchase"] },
    "target_id": { "type": ["string", "null"] },
    "reason": { "type": "string", "maxLength": 300 },
    "suggested_action": { "type": "string", "maxLength": 200 },
    "owner_script": { "type": "string", "maxLength": 500 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "source_type", "source_id", "excerpt"],
        "properties": {
          "evidence_id": { "type": "string" },
          "source_type": { "type": "string", "enum": ["customer_fact", "transaction", "catalog_knowledge", "rule"] },
          "source_id": { "type": "string" },
          "excerpt": { "type": "string", "maxLength": 240 }
        }
      }
    },
    "risk_flags": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["new", "viewed", "adopted", "dismissed", "snoozed", "expired"] }
  }
}
