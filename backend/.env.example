# ================================================
# 美容店智能客户账本 后端环境变量示例
# 使用方法：复制本文件为 backend/.env，然后填写真实值。
# backend/.env 已被 .gitignore 忽略，绝不要提交到版本库。
# ================================================

# ---------- DeepSeek 模型配置 ----------
# 接口地址（默认 https://api.deepseek.com，一般不用改）
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# 模型 ID（当前为 deepseek-v4-pro，需在阶段0做连通性验证）
DEEPSEEK_MODEL_ID=deepseek-v4-pro
# 你的 DeepSeek API Key：只填在 backend/.env，绝不粘贴到聊天、代码或文档
DEEPSEEK_API_KEY=
# V2 真实模型调用开关：默认 false。即使已配置 Key，未获得单独授权也不得开启
ENABLE_V2_REAL_MODEL=false

# ---------- 数据库 ----------
# 留空则使用 backend/data/app.db（SQLite）
DATABASE_URL=

# ---------- 运行环境与邀请内测认证 ----------
# 本地使用 local；云端必须为 production
APP_ENV=local
# 生产必须 false，否则启动直接失败
LOCAL_DEV_OWNER_ENABLED=true
# 本地与生产都保持 false，由 Alembic 升级数据库；仅隔离测试可临时开启
AUTO_CREATE_SCHEMA=false
# 生产由密钥管理注入至少 32 位随机字符，不得写入文件或聊天
SESSION_SECRET=
SESSION_TTL_HOURS=168
# 生产改为 __Host-facai_session；本地 HTTP 不能使用 __Host- Cookie
SESSION_COOKIE_NAME=facai_session
COOKIE_SECURE=false
# 云端关闭 API 文档，本地可保留
EXPOSE_API_DOCS=true
# 生产填 API 网关域名/自有域名，逗号分隔，禁止使用 *
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# ---------- 其他 ----------
LOG_LEVEL=INFO
# 阶段0 模型验证开关：会产生真实模型费用，仅开发环境显式设为 true，生产默认 false
ENABLE_STAGE0_VERIFY=false
# 阶段1 验证状态接口开关：仅开发环境显式设为 true，生产默认 false（不得作为无保护接口）
ENABLE_STAGE1_VERIFY=false
# 阶段2 验证状态接口开关：仅开发环境显式设为 true，生产默认 false（不得作为无保护接口）
ENABLE_STAGE2_VERIFY=false
# 前端开发服务器跨域来源（多个用英文逗号分隔）
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
